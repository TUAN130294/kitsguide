---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Hướng dẫn chi tiết cách sử dụng ClaudeKit - Bộ công cụ AI cho developers và marketers' } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | ClaudeKit Docs</title>
  </head>
  <body class="bg-dark-bg min-h-screen text-gray-100">
    <!-- Background gradient orbs -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-neon-purple/10 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 right-1/4 w-80 h-80 bg-neon-cyan/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 left-1/3 w-72 h-72 bg-neon-pink/5 rounded-full blur-3xl"></div>
    </div>

    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-dark-bg/80 backdrop-blur-xl border-b border-dark-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-neon-cyan to-neon-purple flex items-center justify-center glow-cyan group-hover:scale-110 transition-transform">
              <span class="text-xl font-bold text-white">CK</span>
            </div>
            <span class="text-xl font-bold gradient-text">ClaudeKit</span>
          </a>

          <div class="hidden md:flex items-center gap-1">
            <a href="/" class="nav-link">Trang chủ</a>
            <a href="/commands" class="nav-link">Commands</a>
            <a href="/agents" class="nav-link">Agents</a>
            <a href="/skills" class="nav-link">Skills</a>
            <a href="/workflows" class="nav-link">Workflows</a>
            <a href="/design-system" class="nav-link text-neon-cyan/80 hover:text-neon-cyan">Encyclopedia UI</a>
          </div>

          <div class="flex items-center gap-4">
            <a href="https://github.com/claudekit" target="_blank" class="text-gray-400 hover:text-neon-cyan transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Mobile nav -->
    <div class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-dark-card/95 backdrop-blur-xl border-t border-dark-border">
      <div class="flex justify-around py-3">
        <a href="/" class="mobile-nav-link">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          <span class="text-xs">Home</span>
        </a>
        <a href="/commands" class="mobile-nav-link">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span class="text-xs">Commands</span>
        </a>
        <a href="/agents" class="mobile-nav-link">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          <span class="text-xs">Agents</span>
        </a>
        <a href="/skills" class="mobile-nav-link">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          <span class="text-xs">Skills</span>
        </a>
        <a href="/workflows" class="mobile-nav-link">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
          <span class="text-xs">Workflows</span>
        </a>
        <a href="/design-system" class="mobile-nav-link text-neon-cyan">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
          <span class="text-xs">Design</span>
        </a>
      </div>
    </div>

    <!-- Main content -->
    <main class="pt-16 pb-20 md:pb-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="hidden md:block border-t border-dark-border bg-dark-card/50 backdrop-blur-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-neon-cyan to-neon-purple flex items-center justify-center">
              <span class="text-sm font-bold text-white">CK</span>
            </div>
            <span class="text-gray-400">ClaudeKit Docs</span>
          </div>
          <p class="text-gray-500 text-sm">
            Tài liệu hướng dẫn sử dụng ClaudeKit bằng tiếng Việt
          </p>
          <div class="flex items-center gap-4 text-gray-400 text-sm">
            <a href="https://claudekit.cc" target="_blank" class="hover:text-neon-cyan transition-colors">Website</a>
            <a href="https://docs.claudekit.cc" target="_blank" class="hover:text-neon-cyan transition-colors">Docs</a>
            <a href="https://github.com/claudekit" target="_blank" class="hover:text-neon-cyan transition-colors">GitHub</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
