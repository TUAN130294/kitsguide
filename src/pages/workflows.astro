---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Workflows" description="Các workflow patterns trong ClaudeKit">
  <section class="py-12 px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <span class="gradient-text">Workflows</span>
        </h1>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Hiểu cách ClaudeKit orchestrates commands, agents và skills để hoàn thành tasks phức tạp.
        </p>
      </div>

      <!-- Main Workflow -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 text-center">
          Workflow <span class="text-neon-cyan">chính</span>
        </h2>

        <div class="p-8 rounded-2xl bg-dark-card border border-dark-border">
          <!-- Flow diagram -->
          <div class="flex flex-col items-center gap-6">
            <!-- User Input -->
            <div class="w-full max-w-md p-4 rounded-xl bg-gradient-to-r from-neon-cyan/20 to-neon-purple/20 border border-neon-cyan/30 text-center">
              <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">User Input</div>
              <code class="text-lg text-neon-cyan font-mono">/cook "implement feature"</code>
            </div>

            <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>

            <!-- Command Processing -->
            <div class="w-full max-w-2xl p-6 rounded-xl bg-dark-hover border border-dark-border">
              <div class="text-xs text-gray-500 uppercase tracking-wide mb-3">Command Processing</div>
              <div class="grid md:grid-cols-3 gap-4 text-center text-sm">
                <div class="p-3 rounded-lg bg-dark-card">
                  <div class="text-neon-cyan font-semibold">Parse Arguments</div>
                  <div class="text-gray-500 text-xs">Phân tích đầu vào</div>
                </div>
                <div class="p-3 rounded-lg bg-dark-card">
                  <div class="text-neon-cyan font-semibold">Load Context</div>
                  <div class="text-gray-500 text-xs">Đọc CLAUDE.md, .ck.json</div>
                </div>
                <div class="p-3 rounded-lg bg-dark-card">
                  <div class="text-neon-cyan font-semibold">Activate Skills</div>
                  <div class="text-gray-500 text-xs">Kích hoạt skills cần thiết</div>
                </div>
              </div>
            </div>

            <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>

            <!-- Agent Orchestration -->
            <div class="w-full max-w-3xl p-6 rounded-xl bg-dark-hover border border-dark-border">
              <div class="text-xs text-gray-500 uppercase tracking-wide mb-3">Agent Orchestration</div>

              <!-- Phase 1: Research -->
              <div class="mb-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class="px-2 py-1 rounded bg-neon-purple/20 text-neon-purple text-xs font-semibold">Phase 1</span>
                  <span class="text-white font-medium">Research (Parallel)</span>
                </div>
                <div class="flex flex-wrap gap-3 ml-4">
                  <div class="px-3 py-2 rounded-lg bg-dark-card border border-neon-purple/30">
                    <span class="text-neon-purple">researcher #1</span>
                    <div class="text-xs text-gray-500">database options</div>
                  </div>
                  <div class="px-3 py-2 rounded-lg bg-dark-card border border-neon-purple/30">
                    <span class="text-neon-purple">researcher #2</span>
                    <div class="text-xs text-gray-500">auth methods</div>
                  </div>
                  <div class="px-3 py-2 rounded-lg bg-dark-card border border-neon-purple/30">
                    <span class="text-neon-purple">researcher #3</span>
                    <div class="text-xs text-gray-500">UI patterns</div>
                  </div>
                </div>
              </div>

              <!-- Arrow -->
              <div class="flex justify-center my-4">
                <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                </svg>
              </div>

              <!-- Phase 2: Planning -->
              <div class="mb-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class="px-2 py-1 rounded bg-neon-cyan/20 text-neon-cyan text-xs font-semibold">Phase 2</span>
                  <span class="text-white font-medium">Planning (Sequential)</span>
                </div>
                <div class="flex items-center gap-3 ml-4">
                  <div class="px-3 py-2 rounded-lg bg-dark-card border border-neon-cyan/30">
                    <span class="text-neon-cyan">planner</span>
                    <div class="text-xs text-gray-500">tổng hợp research → plan</div>
                  </div>
                  <span class="text-gray-500">→</span>
                  <div class="px-3 py-2 rounded-lg bg-dark-card border border-gray-600">
                    <span class="text-gray-300">./plans/YYMMDD-feature/</span>
                  </div>
                </div>
              </div>

              <!-- Arrow -->
              <div class="flex justify-center my-4">
                <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                </svg>
              </div>

              <!-- Phase 3: Implementation -->
              <div class="mb-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class="px-2 py-1 rounded bg-neon-pink/20 text-neon-pink text-xs font-semibold">Phase 3</span>
                  <span class="text-white font-medium">Implementation Loop</span>
                </div>
                <div class="flex items-center gap-2 ml-4 flex-wrap">
                  <div class="px-3 py-2 rounded-lg bg-dark-card border border-neon-pink/30">
                    <span class="text-neon-pink">implement</span>
                  </div>
                  <span class="text-gray-500">→</span>
                  <div class="px-3 py-2 rounded-lg bg-dark-card border border-neon-pink/30">
                    <span class="text-neon-pink">tester</span>
                  </div>
                  <span class="text-gray-500">→</span>
                  <div class="px-3 py-2 rounded-lg bg-dark-card border border-neon-pink/30">
                    <span class="text-neon-pink">code-reviewer</span>
                  </div>
                  <span class="text-gray-500">→</span>
                  <span class="text-xs text-gray-400 italic">repeat until pass</span>
                </div>
              </div>

              <!-- Phase 4: Documentation -->
              <div>
                <div class="flex items-center gap-2 mb-3">
                  <span class="px-2 py-1 rounded bg-green-500/20 text-green-400 text-xs font-semibold">Phase 4</span>
                  <span class="text-white font-medium">Finalization (Parallel)</span>
                </div>
                <div class="flex flex-wrap gap-3 ml-4">
                  <div class="px-3 py-2 rounded-lg bg-dark-card border border-green-500/30">
                    <span class="text-green-400">docs-manager</span>
                  </div>
                  <div class="px-3 py-2 rounded-lg bg-dark-card border border-green-500/30">
                    <span class="text-green-400">project-manager</span>
                  </div>
                </div>
              </div>
            </div>

            <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>

            <!-- Output -->
            <div class="w-full max-w-md p-4 rounded-xl bg-gradient-to-r from-green-500/20 to-neon-cyan/20 border border-green-500/30 text-center">
              <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Output</div>
              <div class="text-green-400 font-medium">✓ Feature implemented, tested, documented</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Common Workflow Patterns -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6">
          Workflow <span class="gradient-text">Patterns</span>
        </h2>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Pattern 1: Plan → Code -->
          <div class="p-6 rounded-xl bg-dark-card border border-dark-border">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class="text-2xl">📋</span>
              Plan → Code
            </h3>
            <p class="text-gray-400 text-sm mb-4">
              Tách riêng planning và implementation. Phù hợp cho features phức tạp cần review plan trước.
            </p>
            <div class="space-y-2 font-mono text-sm">
              <div class="p-2 rounded bg-dark-hover text-neon-cyan">/plan "feature description"</div>
              <div class="text-gray-500 text-center text-xs">↓ review & approve plan</div>
              <div class="p-2 rounded bg-dark-hover text-neon-cyan">/code</div>
            </div>
          </div>

          <!-- Pattern 2: Cook (End-to-end) -->
          <div class="p-6 rounded-xl bg-dark-card border border-dark-border">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class="text-2xl">🍳</span>
              Cook (End-to-end)
            </h3>
            <p class="text-gray-400 text-sm mb-4">
              All-in-one workflow: plan → implement → test → review. Phù hợp cho tasks có scope rõ ràng.
            </p>
            <div class="space-y-2 font-mono text-sm">
              <div class="p-2 rounded bg-dark-hover text-neon-purple">/cook "implement feature"</div>
              <div class="text-gray-500 text-xs text-center">↓ tự động research → plan → code → test → review</div>
            </div>
          </div>

          <!-- Pattern 3: Debug → Fix -->
          <div class="p-6 rounded-xl bg-dark-card border border-dark-border">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class="text-2xl">🔧</span>
              Debug → Fix
            </h3>
            <p class="text-gray-400 text-sm mb-4">
              Phân tích issue trước, fix sau. Debug agent chỉ report, không auto-fix.
            </p>
            <div class="space-y-2 font-mono text-sm">
              <div class="p-2 rounded bg-dark-hover text-red-400">/debug "error description"</div>
              <div class="text-gray-500 text-center text-xs">↓ root cause analysis report</div>
              <div class="p-2 rounded bg-dark-hover text-neon-cyan">/fix "based on debug report"</div>
            </div>
          </div>

          <!-- Pattern 4: Parallel Research -->
          <div class="p-6 rounded-xl bg-dark-card border border-dark-border">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class="text-2xl">🔬</span>
              Parallel Research
            </h3>
            <p class="text-gray-400 text-sm mb-4">
              Nhiều researcher agents cùng explore các aspects khác nhau song song.
            </p>
            <div class="space-y-2 font-mono text-sm">
              <div class="p-2 rounded bg-dark-hover text-neon-purple">/ask "architecture question"</div>
              <div class="text-gray-500 text-xs text-center">↓ spawn 3-4 researcher agents parallel</div>
              <div class="flex gap-2">
                <div class="flex-1 p-2 rounded bg-dark-bg text-xs text-gray-400">DB options</div>
                <div class="flex-1 p-2 rounded bg-dark-bg text-xs text-gray-400">Auth methods</div>
                <div class="flex-1 p-2 rounded bg-dark-bg text-xs text-gray-400">Scalability</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- File Communication -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6">
          Agent <span class="gradient-text">Communication</span>
        </h2>

        <div class="p-8 rounded-2xl bg-dark-card border border-dark-border">
          <p class="text-gray-400 mb-6">
            Agents giao tiếp với nhau thông qua file system. Mỗi agent đọc context từ files và write output ra files để agent tiếp theo sử dụng.
          </p>

          <div class="grid md:grid-cols-3 gap-6">
            <!-- Plans -->
            <div class="p-4 rounded-xl bg-dark-hover border border-dark-border">
              <div class="text-neon-cyan font-semibold mb-2">📁 ./plans/</div>
              <p class="text-sm text-gray-400 mb-2">Implementation plans được tạo bởi planner agent.</p>
              <code class="text-xs text-gray-500 block">
                ./plans/YYMMDD-HHmm-feature/<br/>
                ├── plan.md<br/>
                ├── phase-01-setup.md<br/>
                └── phase-02-impl.md
              </code>
            </div>

            <!-- Reports -->
            <div class="p-4 rounded-xl bg-dark-hover border border-dark-border">
              <div class="text-neon-purple font-semibold mb-2">📁 ./plans/reports/</div>
              <p class="text-sm text-gray-400 mb-2">Agent-to-agent communication reports.</p>
              <code class="text-xs text-gray-500 block">
                ./plans/reports/<br/>
                ├── research-db.md<br/>
                ├── research-auth.md<br/>
                └── test-results.md
              </code>
            </div>

            <!-- Docs -->
            <div class="p-4 rounded-xl bg-dark-hover border border-dark-border">
              <div class="text-neon-pink font-semibold mb-2">📁 ./docs/</div>
              <p class="text-sm text-gray-400 mb-2">Project documentation maintained by docs-manager.</p>
              <code class="text-xs text-gray-500 block">
                ./docs/<br/>
                ├── codebase-summary.md<br/>
                ├── code-standards.md<br/>
                └── system-architecture.md
              </code>
            </div>
          </div>
        </div>
      </div>

      <!-- Command Decision Tree -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6">
          <span class="gradient-text">Chọn Command</span> phù hợp
        </h2>

        <div class="p-8 rounded-2xl bg-dark-card border border-dark-border">
          <div class="space-y-4">
            <!-- Question 1 -->
            <div class="p-4 rounded-xl bg-dark-hover">
              <p class="text-white font-medium mb-3">Bạn cần làm gì?</p>
              <div class="grid md:grid-cols-3 gap-3">
                <a href="/commands#cook" class="p-3 rounded-lg bg-dark-card border border-dark-border hover:border-neon-cyan/50 transition-all">
                  <div class="text-neon-cyan font-mono text-sm mb-1">/cook</div>
                  <div class="text-xs text-gray-400">Implement feature mới</div>
                </a>
                <a href="/commands#fix" class="p-3 rounded-lg bg-dark-card border border-dark-border hover:border-neon-cyan/50 transition-all">
                  <div class="text-neon-cyan font-mono text-sm mb-1">/fix</div>
                  <div class="text-xs text-gray-400">Sửa bug / issue</div>
                </a>
                <a href="/commands#plan" class="p-3 rounded-lg bg-dark-card border border-dark-border hover:border-neon-cyan/50 transition-all">
                  <div class="text-neon-cyan font-mono text-sm mb-1">/plan</div>
                  <div class="text-xs text-gray-400">Chỉ lên kế hoạch</div>
                </a>
              </div>
            </div>

            <!-- Question 2 -->
            <div class="p-4 rounded-xl bg-dark-hover">
              <p class="text-white font-medium mb-3">Mức độ phức tạp?</p>
              <div class="grid md:grid-cols-2 gap-3">
                <div class="p-3 rounded-lg bg-dark-card border border-dark-border">
                  <div class="text-neon-purple font-mono text-sm mb-1">/fix:fast hoặc /plan:fast</div>
                  <div class="text-xs text-gray-400">Tasks đơn giản, scope nhỏ</div>
                </div>
                <div class="p-3 rounded-lg bg-dark-card border border-dark-border">
                  <div class="text-neon-purple font-mono text-sm mb-1">/fix:hard hoặc /plan:hard</div>
                  <div class="text-xs text-gray-400">Tasks phức tạp, multi-component</div>
                </div>
              </div>
            </div>

            <!-- Question 3 -->
            <div class="p-4 rounded-xl bg-dark-hover">
              <p class="text-white font-medium mb-3">Loại vấn đề cụ thể?</p>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <div class="p-3 rounded-lg bg-dark-card border border-dark-border text-center">
                  <div class="text-neon-pink font-mono text-xs mb-1">/fix:types</div>
                  <div class="text-xs text-gray-500">TypeScript errors</div>
                </div>
                <div class="p-3 rounded-lg bg-dark-card border border-dark-border text-center">
                  <div class="text-neon-pink font-mono text-xs mb-1">/fix:ui</div>
                  <div class="text-xs text-gray-500">UI/UX issues</div>
                </div>
                <div class="p-3 rounded-lg bg-dark-card border border-dark-border text-center">
                  <div class="text-neon-pink font-mono text-xs mb-1">/fix:ci</div>
                  <div class="text-xs text-gray-500">CI/CD failures</div>
                </div>
                <div class="p-3 rounded-lg bg-dark-card border border-dark-border text-center">
                  <div class="text-neon-pink font-mono text-xs mb-1">/fix:test</div>
                  <div class="text-xs text-gray-500">Test failures</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tips -->
      <div class="p-8 rounded-2xl bg-gradient-to-r from-neon-cyan/10 to-neon-purple/10 border border-neon-cyan/30">
        <h3 class="text-xl font-bold text-white mb-4">💡 Tips sử dụng Workflows hiệu quả</h3>
        <ul class="space-y-3 text-gray-300">
          <li class="flex items-start gap-3">
            <span class="text-neon-cyan">✓</span>
            <span>Luôn đọc <code class="text-neon-cyan">./README.md</code> và <code class="text-neon-cyan">./docs</code> trước khi bắt đầu task mới</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-neon-cyan">✓</span>
            <span>Sử dụng <code class="text-neon-cyan">/scout</code> để tìm hiểu codebase trước khi implement</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-neon-cyan">✓</span>
            <span>Không skip tests - <code class="text-neon-cyan">tester</code> agent sẽ validate implementation</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-neon-cyan">✓</span>
            <span>Review plan từ <code class="text-neon-cyan">/plan</code> trước khi chạy <code class="text-neon-cyan">/code</code></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-neon-cyan">✓</span>
            <span>Sử dụng <code class="text-neon-cyan">/watzup</code> để check project status bất kỳ lúc nào</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
