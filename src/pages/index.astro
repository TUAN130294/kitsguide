---
import Layout from '../layouts/Layout.astro';
import { commands } from '../data/commands';
import { agents } from '../data/agents';
import { skills } from '../data/skills';

const popularCommands = commands.filter(c =>
  ['/cook', '/plan', '/fix', '/code'].includes(c.name)
);

const stats = {
  commands: commands.length,
  agents: agents.length,
  skills: skills.length
};
---

<Layout title="Trang chủ">
  <div class="relative min-h-screen bg-black selection:bg-neon-cyan/30 overflow-x-hidden">
    <!-- Aurora Background -->
    <div class="fixed inset-0 bg-grid-pattern opacity-30 pointer-events-none z-0"></div>
    <div class="fixed inset-0 aurora-bg opacity-40 pointer-events-none z-0"></div>
    
    <!-- Hero Section -->
    <section class="relative z-10 pt-32 pb-20 px-4 min-h-[90vh] flex flex-col justify-center">
      <div class="max-w-7xl mx-auto text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md mb-8 animate-fade-in-up hover:border-neon-cyan/50 transition-colors cursor-pointer group">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-neon-cyan opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-neon-cyan"></span>
            </span>
            <span class="text-xs font-medium text-gray-300 tracking-wide uppercase group-hover:text-white transition-colors">ClaudeKit Docs 2.0 • Live Preview</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-6xl md:text-9xl font-black mb-6 tracking-tighter leading-none reveal-on-scroll">
          <span class="text-white drop-shadow-[0_0_30px_rgba(255,255,255,0.2)]">Claude</span><span class="gradient-text glow-text-cyan">Kit</span>
        </h1>

        <p class="text-xl md:text-3xl text-gray-400 mb-12 max-w-3xl mx-auto font-light leading-relaxed reveal-on-scroll" style="transition-delay: 100ms">
          Build <span class="typing-cursor text-neon-cyan font-medium" id="typing-text">AI Agents</span>
        </p>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-6 justify-center items-center mb-24 reveal-on-scroll" style="transition-delay: 200ms">
            <a href="/commands" class="group relative px-8 py-4 bg-white text-black rounded-full font-bold text-lg hover:scale-105 transition-transform duration-300">
                <span class="relative z-10 flex items-center gap-2">
                    Start Building
                    <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </span>
                <div class="absolute inset-0 rounded-full bg-neon-cyan blur-lg opacity-40 group-hover:opacity-60 transition-opacity -z-10"></div>
            </a>
            <a href="/design-system" class="px-8 py-4 rounded-full border border-white/20 text-white font-medium hover:bg-white/10 transition-colors backdrop-blur-sm flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                Design System
            </a>
        </div>
      </div>
    </section>

    <!-- Bento Grid Section -->
    <section class="max-w-7xl mx-auto px-4 pb-32 relative z-10 reveal-on-scroll">
        <h2 class="text-3xl font-bold text-white mb-8 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-neon-blue flex items-center justify-center text-white text-lg font-bold">1</span>
          Power Kits
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-6 md:grid-rows-2 gap-6 h-auto md:h-[600px]">
            
            <!-- Card 1: Engineer Kit (Large) -->
            <div class="md:col-span-4 md:row-span-2 group relative overflow-hidden rounded-3xl glassy-panel border border-white/10 spotlight-card hover:border-white/20 transition-colors bg-dark-card/50 backdrop-blur-xl">
                <div class="absolute inset-0 bg-gradient-to-br from-neon-cyan/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="p-10 h-full flex flex-col justify-between relative z-10">
                    <div>
                        <div class="flex justify-between items-start">
                             <div class="w-14 h-14 rounded-2xl bg-neon-cyan/10 border border-neon-cyan/20 flex items-center justify-center text-neon-cyan mb-6 shadow-[0_0_30px_rgba(0,245,255,0.1)]">
                                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                            </div>
                            <span class="px-3 py-1 rounded-full bg-neon-cyan/10 text-neon-cyan text-xs font-bold uppercase tracking-wider border border-neon-cyan/20">Recommended</span>
                        </div>
                        <h3 class="text-4xl font-bold text-white mb-3">Engineer Kit</h3>
                        <p class="text-gray-300 text-lg max-w-md leading-relaxed">
                            Biến một developer thành cả team DevOps. Tự động hóa từ PR review, testing đến deployment với AI Agents chuyên biệt.
                        </p>
                    </div>
                    
                    <div class="mt-8">
                        <div class="flex gap-2 mb-4">
                            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-gray-300 hover:bg-white/10 transition-colors cursor-default">#codegen</span>
                            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-gray-300 hover:bg-white/10 transition-colors cursor-default">#testing</span>
                            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-gray-300 hover:bg-white/10 transition-colors cursor-default">#debug</span>
                        </div>
                        <!-- Fake Terminal -->
                        <div class="w-full h-48 bg-[#0d1117] rounded-xl border border-white/10 p-4 font-mono text-xs text-gray-400 overflow-hidden relative shadow-2xl">
                             <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-neon-cyan via-neon-purple to-neon-cyan animate-shimmer-fast"></div>
                             <div class="flex gap-1.5 mb-3">
                                 <div class="w-2.5 h-2.5 rounded-full bg-red-500/50"></div>
                                 <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/50"></div>
                                 <div class="w-2.5 h-2.5 rounded-full bg-green-500/50"></div>
                             </div>
                             <div class="space-y-1">
                                 <p><span class="text-neon-purle">➜</span> <span class="text-white">claude</span> /cook <span class="text-yellow-300">"optimize database"</span></p>
                                 <p class="text-gray-500">[10:02:45] Agent Planner analyzing schema...</p>
                                 <p class="text-gray-500">[10:02:47] Identified slow query in users_table</p>
                                 <p class="text-neon-cyan">[10:02:50] Agent Coder generating migration...</p>
                                 <p class="text-gray-300">> Created file: 20240106_add_index.sql</p>
                                 <p class="text-green-400">✔ Optimization complete (Speed +400%)</p>
                                 <p class="animate-pulse">_</p>
                             </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: Marketing Kit (Small) -->
             <div class="md:col-span-2 md:row-span-1 group relative overflow-hidden rounded-3xl bg-dark-card/50 backdrop-blur-xl border border-white/10 spotlight-card hover:border-white/20 transition-colors">
                <div class="p-8 h-full relative z-10 flex flex-col">
                    <div class="w-12 h-12 rounded-2xl bg-neon-purple/20 border border-neon-purple/30 flex items-center justify-center text-neon-purple mb-6">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6"/></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-2">Marketing Kit</h3>
                    <p class="text-gray-400 text-sm mb-4">SEO, Blog & Campaign Automation platform.</p>
                    <a href="/commands?kit=marketing" class="mt-auto inline-flex items-center text-neon-purple text-sm font-bold hover:underline">
                        Explore commands <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    </a>
                </div>
                 <div class="absolute bottom-0 right-0 w-32 h-32 bg-neon-purple/20 blur-[50px] rounded-full pointer-events-none"></div>
            </div>

            <!-- Card 3: Stats (Small) -->
            <div class="md:col-span-2 md:row-span-1 group relative overflow-hidden rounded-3xl bg-dark-card/50 backdrop-blur-xl border border-white/10 spotlight-card hover:border-white/20 transition-colors">
                 <div class="p-8 h-full flex items-center justify-between relative z-10">
                    <div class="text-center">
                        <div class="text-4xl font-bold text-white mb-1 drop-shadow-lg">{stats.commands}+</div>
                        <div class="text-xs text-gray-500 uppercase tracking-widest">Commands</div>
                    </div>
                    <div class="h-12 w-px bg-white/10"></div>
                     <div class="text-center">
                        <div class="text-4xl font-bold text-white mb-1 drop-shadow-lg">{stats.agents}</div>
                        <div class="text-xs text-gray-500 uppercase tracking-widest">Agents</div>
                    </div>
                 </div>
            </div>

        </div>
    </section>

    <!-- Use Cases Interactive Section -->
    <section class="max-w-7xl mx-auto px-4 pb-32 relative z-10 reveal-on-scroll">
         <h2 class="text-3xl font-bold text-white mb-8 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-neon-pink flex items-center justify-center text-white text-lg font-bold">2</span>
          Real-world Workflows
        </h2>

         <div class="rounded-3xl border border-white/10 bg-dark-card/50 backdrop-blur-xl overflow-hidden" x-data="{ tab: 'dev' }">
             <!-- Tabs Header -->
             <div class="flex border-b border-white/10">
                 <button class="flex-1 py-4 text-center font-medium text-gray-400 hover:text-white transition-colors tab-btn active" onclick="switchTab('dev', this)">
                    👨‍💻 Developer Cases
                 </button>
                 <button class="flex-1 py-4 text-center font-medium text-gray-400 hover:text-white transition-colors tab-btn" onclick="switchTab('marketing', this)">
                    🚀 Marketer Cases
                 </button>
             </div>

             <!-- Content -->
             <div class="p-8 min-h-[300px]">
                 <!-- Developer Content -->
                 <div id="tab-dev" class="grid md:grid-cols-3 gap-6 animate-fade-in">
                     <div class="p-6 rounded-2xl bg-white/5 border border-white/5 hover:border-neon-cyan/30 transition-all">
                         <div class="text-neon-cyan mb-3 font-mono text-sm">/cook "implement login"</div>
                         <h4 class="text-white font-bold mb-2">Build Feature</h4>
                         <p class="text-gray-400 text-sm">Agent tự động research auth patterns, viết code Astro/React, tạo API routes và update document.</p>
                     </div>
                      <div class="p-6 rounded-2xl bg-white/5 border border-white/5 hover:border-neon-cyan/30 transition-all">
                         <div class="text-neon-cyan mb-3 font-mono text-sm">/fix "memory leak"</div>
                         <h4 class="text-white font-bold mb-2">Debug & Fix</h4>
                         <p class="text-gray-400 text-sm">Phân tích heap snapshot, tìm nguồn leak, đề xuất patch và chạy regression test.</p>
                     </div>
                      <div class="p-6 rounded-2xl bg-white/5 border border-white/5 hover:border-neon-cyan/30 transition-all">
                         <div class="text-neon-cyan mb-3 font-mono text-sm">/scout "competitor api"</div>
                         <h4 class="text-white font-bold mb-2">Technical Research</h4>
                         <p class="text-gray-400 text-sm">Quét tài liệu API đối thủ, so sánh feature parity và generate báo cáo kỹ thuật.</p>
                     </div>
                 </div>

                 <!-- Marketing Content -->
                 <div id="tab-marketing" class="hidden grid md:grid-cols-3 gap-6 animate-fade-in">
                      <div class="p-6 rounded-2xl bg-white/5 border border-white/5 hover:border-neon-purple/30 transition-all">
                         <div class="text-neon-purple mb-3 font-mono text-sm">/plan "launch campaign"</div>
                         <h4 class="text-white font-bold mb-2">Campaign Strategy</h4>
                         <p class="text-gray-400 text-sm">Lên kế hoạch content 30 ngày, draft email sequence và social media calendar.</p>
                     </div>
                      <div class="p-6 rounded-2xl bg-white/5 border border-white/5 hover:border-neon-purple/30 transition-all">
                         <div class="text-neon-purple mb-3 font-mono text-sm">/write "seo blog post"</div>
                         <h4 class="text-white font-bold mb-2">SEO Content</h4>
                         <p class="text-gray-400 text-sm">Viết bài chuẩn SEO, tối ưu keyword density, tạo meta tags và internal links.</p>
                     </div>
                      <div class="p-6 rounded-2xl bg-white/5 border border-white/5 hover:border-neon-purple/30 transition-all">
                         <div class="text-neon-purple mb-3 font-mono text-sm">/analyze "user funnel"</div>
                         <h4 class="text-white font-bold mb-2">Analytics Audit</h4>
                         <p class="text-gray-400 text-sm">Phân tích drop-off points, đề xuất A/B test variants để tăng conversion.</p>
                     </div>
                 </div>
             </div>
         </div>
    </section>

    <!-- Bottom Action Grid -->
    <section class="max-w-7xl mx-auto px-4 pb-32 relative z-10 reveal-on-scroll">
         <h2 class="text-3xl font-bold text-white mb-8 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-neon-cyan flex items-center justify-center text-dark-bg text-lg font-bold">3</span>
          Quick Start Commands
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {popularCommands.slice(0, 3).map(cmd => (
                <a href={`/commands#${cmd.name.replace('/','')}`} class="group relative p-6 rounded-2xl bg-dark-card/50 backdrop-blur-lg border border-white/10 hover:border-neon-cyan/50 hover:bg-white/5 transition-all flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-black flex items-center justify-center text-neon-cyan font-mono border border-white/10 group-hover:scale-110 transition-transform shadow-lg shadow-neon-cyan/5">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </div>
                    <div class="flex-1">
                        <h4 class="text-white font-bold font-mono text-lg mb-1">{cmd.name}</h4>
                        <p class="text-xs text-gray-400 line-clamp-1 group-hover:text-gray-300 transition-colors">{cmd.description}</p>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center group-hover:bg-neon-cyan group-hover:text-black transition-all">
                         <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                </a>
            ))}
        </div>
    </section>

  </div>
</Layout>

<script is:inline>
// Spotlight effect
document.addEventListener('mousemove', (e) => {
    const cards = document.querySelectorAll('.spotlight-card');
    cards.forEach(card => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
    });
});

// Typing effect
const texts = ["AI Agents", "Super Teams", "Automation", "Future"];
let textIndex = 0;
let charIndex = 0;
let isDeleting = false;
const typeTarget = document.getElementById('typing-text');

function type() {
    const currentText = texts[textIndex];
    
    if (isDeleting) {
        typeTarget.textContent = currentText.substring(0, charIndex - 1);
        charIndex--;
    } else {
        typeTarget.textContent = currentText.substring(0, charIndex + 1);
        charIndex++;
    }

    let typeSpeed = isDeleting ? 100 : 200;

    if (!isDeleting && charIndex === currentText.length) {
        typeSpeed = 2000;
        isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        textIndex = (textIndex + 1) % texts.length;
        typeSpeed = 500;
    }

    setTimeout(type, typeSpeed);
}
type();

// Tab Switcher
window.switchTab = (tabId, btn) => {
    // Hide all
    document.getElementById('tab-dev').classList.add('hidden');
    document.getElementById('tab-marketing').classList.add('hidden');
    
    // Reset buttons
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    
    // Show target
    document.getElementById(`tab-${tabId}`).classList.remove('hidden');
    btn.classList.add('active');
}

// Scroll Reveal
const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
        }
    });
});

document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el));
</script>
